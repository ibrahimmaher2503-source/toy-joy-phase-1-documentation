#!/usr/bin/env bash

set -Eeuo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
EXPECTED_PROJECT="toy-joy-phase-1-documentation"

if [[ -z "$ROOT" || "$(basename "$ROOT")" != "$EXPECTED_PROJECT" ]]; then
    echo "pre-commit: repository identity check failed." >&2
    echo "expected project=$EXPECTED_PROJECT root=$ROOT" >&2
    exit 1
fi

cd "$ROOT"

if ! git diff --cached --check; then
    echo "pre-commit: staged whitespace errors detected." >&2
    exit 1
fi

PHP_FILES="$(git diff --cached --name-only --diff-filter=ACM -- '*.php')"
if [[ -n "$PHP_FILES" ]]; then
    echo "pre-commit: Pint check"
    vendor/bin/pint --test $PHP_FILES
else
    echo "pre-commit: Pint skipped (no staged PHP files)"
fi

echo "pre-commit: PHPStan"
vendor/bin/phpstan analyse --no-progress

echo "pre-commit: locale key parity"
php scripts/check-locale-keys.php

echo "pre-commit: PASS project=$EXPECTED_PROJECT root=$ROOT"
